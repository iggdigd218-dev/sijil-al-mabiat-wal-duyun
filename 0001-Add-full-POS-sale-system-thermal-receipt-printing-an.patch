diff --git a/.github/workflows/build-flutter-apk.yml b/.github/workflows/build-flutter-apk.yml
new file mode 100644
index 0000000..72fbffe
--- /dev/null
+++ b/.github/workflows/build-flutter-apk.yml
@@ -0,0 +1,63 @@
+name: Build Flutter Android APK
+
+on:
+  push:
+    branches: [ flutter-native ]
+  pull_request:
+    branches: [ flutter-native ]
+  workflow_dispatch:
+
+permissions:
+  contents: write
+
+jobs:
+  build:
+    name: Build Flutter Release APK
+    runs-on: ubuntu-latest
+    steps:
+      - name: Checkout repository
+        uses: actions/checkout@v4
+
+      - name: Set up Java JDK 17
+        uses: actions/setup-java@v4
+        with:
+          distribution: 'temurin'
+          java-version: '17'
+
+      - name: Set up Flutter
+        uses: subosito/flutter-action@v2
+        with:
+          flutter-version: '3.24.x'
+          channel: 'stable'
+          cache: true
+
+      - name: Get Flutter dependencies
+        run: flutter pub get
+
+      - name: Build Android APK
+        run: flutter build apk --release
+
+      - name: Upload APK Artifact
+        uses: actions/upload-artifact@v4
+        with:
+          name: nexora-flutter-native-v3.4.0
+          path: build/app/outputs/flutter-apk/app-release.apk
+          retention-days: 30
+
+      - name: Create GitHub Release with APK
+        uses: softprops/action-gh-release@v2
+        if: github.ref == 'refs/heads/flutter-native'
+        with:
+          tag_name: flutter-v3.4.${{ github.run_number }}
+          name: Nexora Flutter Native v3.4.${{ github.run_number }}
+          body: |
+            ## 📱 إطلاق تطبيق الأندرويد الأصلي Nexora Flutter Native
+            تم بناء التطبيق الأصلي بنجاح وهو متاح للتنزيل المباشر والتثبيت الفوري:
+            - **الملف المرفق**: `app-release.apk`
+            - **الفرع**: `flutter-native`
+            - تاريخ الإصدار: ${{ github.event.head_commit.timestamp }}
+          files: build/app/outputs/flutter-apk/app-release.apk
+          draft: false
+          prerelease: false
+        env:
+          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
