{
  "rules": {
    "workspaces": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$ws": {
        "operations": {
          ".indexOn": ["server_ts", "timestamp"],
          ".read": "auth != null",
          ".write": "auth != null"
        },
        "roster": {
          ".read": "auth != null",
          ".write": "auth != null",
          ".indexOn": ["updated_at"]
        },
        "evictions": {
          ".read": "auth != null",
          ".write": "auth != null"
        },
        "invites": {
          ".read": "auth != null",
          ".write": "auth != null",
          ".indexOn": ["expiresAt", "pin"]
        },
        "joinRequests": {
          ".read": "auth != null",
          ".write": "auth != null",
          ".indexOn": ["status", "requestedAt"]
        },
        "joinSnapshot": {
          ".read": "auth != null",
          ".write": "auth != null"
        },
        "members": {
          ".read": "auth != null",
          ".write": "auth != null"
        },
        "subscription": {
          ".read": "auth != null",
          ".write": "auth != null"
        },
        "creator": {
          ".read": "auth != null",
          ".write": "auth != null"
        },
        "codes": {
          ".read": "auth != null",
          ".write": "auth != null"
        }
      }
    },
    "server_clock": {
      ".read": true,
      ".write": "auth != null"
    },
    "trials": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "invite_index": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["expiresAt", "ws"]
    }
  }
}
