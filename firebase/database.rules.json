{
  "rules": {
    "workspaces": {
      ".read": true,
      ".write": true,
      "$ws": {
        "operations": {
          ".indexOn": [
            "server_ts",
            "timestamp"
          ],
          ".read": true,
          ".write": true
        },
        "roster": {
          ".read": true,
          ".write": true
        },
        "evictions": {
          ".read": true,
          ".write": true
        },
        "invites": {
          ".read": true,
          ".write": true
        },
        "joinRequests": {
          ".read": true,
          ".write": true
        },
        "joinSnapshot": {
          ".read": true,
          ".write": true
        },
        "members": {
          ".read": true,
          ".write": true
        },
        "subscription": {
          ".read": true,
          ".write": true
        },
        "creator": {
          ".read": true,
          ".write": true
        },
        "codes": {
          ".read": true,
          ".write": true
        }
      }
    },
    "server_clock": {
      ".read": true,
      ".write": true
    },
    "trials": {
      ".read": true,
      ".write": true
    },
    "invite_index": {
      ".read": true,
      ".write": true
    }
  }
}
